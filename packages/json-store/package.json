{
  "name": "@tool-collection/json-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm verify",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "firebase": "^11.0.0 || ^12.0.0 || ^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "dotenv": "^18.0.7",
    "firebase": "^13.0.0",
    "typescript": "~5.9.3",
    "undici": "^6.29.0",
    "vitest": "^3.2.7"
  }
}
